# Postgres (Neon from the Vercel Marketplace sets this; locally: postgres://localhost/token_metrics)
DATABASE_URL=
# SMTP for sign-in codes. Defaults to Gmail (smtp.gmail.com:465); SMTP_PASS is a Google app password.
# Without SMTP_USER/SMTP_PASS, codes are printed to the server log (dev only).
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
# Gmail only sends as the signed-in account, so keep the address equal to SMTP_USER
EMAIL_FROM="Token Metrics <you@gmail.com>"
# Only these addresses can sign in; comma-separated domains
ALLOWED_DOMAINS=devxlabs.ai
# Comma-separated emails that can open /admin
ADMIN_EMAILS=
# Public base URL, used in card links (e.g. https://leaderboard.devxlabs.ai)
PUBLIC_URL=http://localhost:3000
